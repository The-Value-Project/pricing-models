{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/The-Value-Project/pricing-models/blob/main/schemas/deal_configuration.json",
  "title": "DealConfiguration",
  "description": "Customer-specific deal referencing a PricingModel instance. Created by a salesperson or LLM. Implementations may extend the top-level object (e.g. with config_notes, approval metadata, or CRM references) without breaking conformance with the standard. Part of The Value Project open standard. Schema license: Apache-2.0 (https://www.apache.org/licenses/LICENSE-2.0). Copyright 2026 The Value Project (https://github.com/The-Value-Project/pricing-models).",
  "x-license": {
    "spdx": "Apache-2.0",
    "url": "https://www.apache.org/licenses/LICENSE-2.0",
    "copyright": "Copyright 2026 The Value Project (an initiative by ValueIQ — https://valueiq.ai)",
    "full-text": "LICENSE-CODE",
    "repo": "https://github.com/The-Value-Project/pricing-models"
  },
  "x-version": "1.0.0",
  "x-part-of": "The Value Project — https://github.com/The-Value-Project",
  "x-related-schemas": {
    "PricingModel": "https://github.com/The-Value-Project/pricing-models/blob/main/schemas/pricing_model.json",
    "InvoiceStatement": "https://github.com/The-Value-Project/pricing-models/blob/main/schemas/invoice_statement.json",
    "CustomerVariables": "https://github.com/The-Value-Project/value-models/blob/main/schemas/customer_variables.json"
  },
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "config_id",
    "config_date",
    "model_reference",
    "customer",
    "deal_motion",
    "billing",
    "product_selections",
    "bundle_selections",
    "discount_selections",
    "negotiated_overrides"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Version of this schema that the document conforms to: any 2.x release, for example 2.0.0. Later 2.x releases accept every document that is valid under an earlier 2.x release."
    },
    "config_id": {
      "$ref": "#/$defs/id"
    },
    "config_date": {
      "type": "string",
      "description": "ISO date."
    },
    "model_reference": {
      "type": "object",
      "required": [
        "model_id"
      ],
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            }
          ],
          "description": "Matches pricing_model context."
        }
      }
    },
    "customer": {
      "type": "object",
      "required": [
        "name",
        "domain",
        "region"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "description": "For price book resolution."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "deal_motion": {
      "type": "string",
      "enum": [
        "new_logo",
        "renewal",
        "expansion",
        "reprice"
      ],
      "description": "For variant resolution."
    },
    "billing": {
      "type": "object",
      "required": [
        "plan_id",
        "contract_start_date",
        "contract_term_months"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Deprecated in 2.0.0. References products[].commitment_plans[].id. It can address the commitment plans of only one product, so it cannot describe a multi-product deal. It is the default for any product selection whose commitment_plan_id is null, for the product that owns the plan it names. Null means no default. Replaced by product_selections[].commitment_plan_id. Earliest removal: two MINOR releases after 2.0.0."
        },
        "contract_start_date": {
          "type": "string"
        },
        "contract_term_months": {
          "type": "integer"
        },
        "payment_terms": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "product_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "tier_id",
          "commitment_plan_id",
          "quantities",
          "module_selections",
          "credit_package_selections"
        ],
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "$ref": "#/$defs/id"
          },
          "tier_id": {
            "$ref": "#/$defs/id"
          },
          "commitment_plan_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "References products[].commitment_plans[].id of this product. Null means billing.plan_id applies if it names a plan of this product, and otherwise no commitment plan."
          },
          "quantities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "credit_type_id",
                "quantity",
                "quantity_type",
                "growth_schedule"
              ],
              "additionalProperties": false,
              "properties": {
                "credit_type_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/id"
                    }
                  ],
                  "description": "References credit_types[].id."
                },
                "quantity": {
                  "type": "number"
                },
                "quantity_type": {
                  "type": "string",
                  "enum": [
                    "committed",
                    "estimated",
                    "maximum",
                    "starting"
                  ]
                },
                "growth_schedule": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "period_label",
                          "period_index",
                          "quantity"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "period_label": {
                            "type": "string",
                            "description": "Display text only. Calculation uses period_index."
                          },
                          "period_index": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Contract year the quantity applies to, counting from 1. Unique within the schedule. A year not in the schedule uses the entry's own quantity."
                          },
                          "quantity": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "module_selections": {
            "type": "array",
            "description": "Modules selected in addition to the tier: add-ons, which are modules in no tier's included_modules. Empty when none. A module that the chosen tier already includes MUST NOT appear here.",
            "items": {
              "type": "object",
              "required": [
                "module_id"
              ],
              "additionalProperties": false,
              "properties": {
                "module_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/id"
                    }
                  ],
                  "description": "References products[].modules[].id of this product."
                }
              }
            }
          },
          "credit_package_selections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "credit_package_id",
                "quantity"
              ],
              "additionalProperties": false,
              "properties": {
                "credit_package_id": {
                  "$ref": "#/$defs/id"
                },
                "quantity": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "bundle_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bundle_id"
        ],
        "additionalProperties": false,
        "properties": {
          "bundle_id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "discount_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "discount_id",
          "manual_value"
        ],
        "additionalProperties": false,
        "properties": {
          "discount_id": {
            "$ref": "#/$defs/id"
          },
          "manual_value": {
            "anyOf": [
              {
                "type": "number",
                "description": "For mode=manual discounts."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "negotiated_overrides": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "price_overrides",
            "credit_grant_overrides",
            "custom_terms"
          ],
          "additionalProperties": false,
          "properties": {
            "price_overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "target_kind",
                  "target_id",
                  "override_type",
                  "override_value",
                  "description"
                ],
                "additionalProperties": false,
                "properties": {
                  "target_kind": {
                    "type": "string",
                    "enum": [
                      "module",
                      "credit_package",
                      "credit_type_overage",
                      "total_deal"
                    ],
                    "description": "What target_id is. module and credit_package: a priced item. credit_type_overage: the overage price of a credit type (override_type custom_unit_price replaces the price per unit of overage). total_deal: the whole deal, and target_id is null."
                  },
                  "target_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/id"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Id of the module, credit package or credit type. Null when target_kind is total_deal."
                  },
                  "override_type": {
                    "type": "string",
                    "enum": [
                      "fixed_price",
                      "discount_percentage",
                      "discount_amount",
                      "custom_unit_price",
                      "waived",
                      "capped"
                    ]
                  },
                  "override_value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "target_kind": {
                          "const": "total_deal"
                        }
                      },
                      "required": [
                        "target_kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "target_id": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "target_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "credit_grant_overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "credit_type_id",
                  "period",
                  "new_quantity",
                  "description"
                ],
                "additionalProperties": false,
                "properties": {
                  "credit_type_id": {
                    "$ref": "#/$defs/id"
                  },
                  "period": {
                    "type": "string",
                    "enum": [
                      "monthly",
                      "annual",
                      "per_billing_period",
                      "concurrent",
                      "lifetime",
                      "one_time"
                    ],
                    "description": "The grant period this override replaces. The override replaces the pool for (credit_type_id, period)."
                  },
                  "new_quantity": {
                    "type": "number",
                    "description": "Replaces the granted quantity of the pool. Use -1 for unlimited."
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            },
            "custom_terms": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "term_type",
                  "description"
                ],
                "additionalProperties": false,
                "properties": {
                  "term_type": {
                    "type": "string",
                    "enum": [
                      "sla_upgrade",
                      "support_upgrade",
                      "custom_overage_rate",
                      "price_lock",
                      "mfn_clause",
                      "termination_right",
                      "data_terms",
                      "other"
                    ],
                    "description": "custom_overage_rate is informational. A rate the engine calculates with is a price override with target_kind credit_type_overage."
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "config_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "An id: opaque and case-sensitive, lower-case words joined by hyphens. It stays the same across versions of a model while its object exists, and is never reused for a different object."
    }
  }
}
