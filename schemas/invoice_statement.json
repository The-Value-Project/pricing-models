{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/The-Value-Project/pricing-models/blob/main/schemas/invoice_statement.json",
  "title": "InvoiceStatement",
  "description": "Computed pricing output from a PricingModel and DealConfiguration. Implementations may extend the top-level object (e.g. with computation_notes, audit trail, or rendering hints) without breaking conformance with the standard. Part of The Value Project open standard. Schema license: Apache-2.0 (https://www.apache.org/licenses/LICENSE-2.0). Copyright 2026 The Value Project (https://github.com/The-Value-Project/pricing-models).",
  "x-license": {
    "spdx": "Apache-2.0",
    "url": "https://www.apache.org/licenses/LICENSE-2.0",
    "copyright": "Copyright 2026 The Value Project (an initiative by ValueIQ — https://valueiq.ai)",
    "full-text": "LICENSE-CODE",
    "repo": "https://github.com/The-Value-Project/pricing-models"
  },
  "x-version": "1.0.0",
  "x-part-of": "The Value Project — https://github.com/The-Value-Project",
  "x-related-schemas": {
    "PricingModel": "https://github.com/The-Value-Project/pricing-models/blob/main/schemas/pricing_model.json",
    "DealConfiguration": "https://github.com/The-Value-Project/pricing-models/blob/main/schemas/deal_configuration.json"
  },
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "invoice_id",
    "config_id",
    "model_id",
    "period",
    "currency",
    "line_items",
    "subtotals",
    "adjustments",
    "totals",
    "entitlement_summary",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Version of this schema that the document conforms to: any 2.x release, for example 2.0.0. Later 2.x releases accept every document that is valid under an earlier 2.x release."
    },
    "invoice_id": {
      "$ref": "#/$defs/id"
    },
    "config_id": {
      "$ref": "#/$defs/id"
    },
    "model_id": {
      "allOf": [
        {
          "$ref": "#/$defs/id"
        }
      ],
      "description": "References PricingModel.model_id."
    },
    "period": {
      "type": "object",
      "required": [
        "label",
        "start_date",
        "end_date",
        "period_type"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "period_type": {
          "type": "string",
          "enum": [
            "monthly",
            "quarterly",
            "annual",
            "contract_total"
          ]
        }
      }
    },
    "currency": {
      "allOf": [
        {
          "$ref": "#/$defs/currency_code"
        }
      ],
      "description": "Currency of every amount in this statement. One currency per statement."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "category",
          "description",
          "product_id",
          "target_id",
          "quantity",
          "unit",
          "unit_price",
          "line_total",
          "computation_method",
          "source_fields"
        ],
        "additionalProperties": false,
        "properties": {
          "line_id": {
            "type": "integer",
            "description": "Line number, 1 to n, in phase order and then input-array order."
          },
          "category": {
            "type": "string",
            "enum": [
              "module_charge",
              "credit_package",
              "usage_overage",
              "one_time_fee",
              "minimum_commitment_true_up",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "product_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "Product the line belongs to. Null for a line that belongs to no single product, such as a contract-level true-up."
          },
          "target_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "module_id, credit_package_id, etc."
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          },
          "graduated_detail": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "band_label",
                    "quantity_in_band",
                    "unit_price",
                    "band_total"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "band_label": {
                      "type": "string"
                    },
                    "quantity_in_band": {
                      "type": "number"
                    },
                    "unit_price": {
                      "type": "number"
                    },
                    "band_total": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "computation_method": {
            "type": "string"
          },
          "source_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(model|config)#(/([^/~]|~[01])*)*$"
            },
            "description": "Where the numbers on this line come from. Each entry is \"model#\" or \"config#\" followed by an RFC 6901 JSON Pointer into that document as received, for example \"model#/products/0/modules/1/price/amount\"."
          }
        }
      }
    },
    "subtotals": {
      "type": "object",
      "required": [
        "recurring",
        "one_time",
        "gross"
      ],
      "additionalProperties": false,
      "properties": {
        "recurring": {
          "type": "number"
        },
        "one_time": {
          "type": "number"
        },
        "gross": {
          "type": "number"
        }
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adjustment_type",
          "description",
          "amount",
          "applies_to",
          "computation_method",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "adjustment_type": {
            "type": "string",
            "enum": [
              "commitment_plan_adjustment",
              "negotiated_discount_percentage",
              "negotiated_discount_amount",
              "negotiated_fixed_price",
              "waived_fee",
              "price_cap",
              "volume_discount",
              "bundle_discount",
              "minimum_true_up",
              "strategy_discount",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "Signed: negative=discount, positive=true-up."
          },
          "applies_to": {
            "type": "string"
          },
          "computation_method": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "total_adjustments",
        "net_total",
        "annualized_total",
        "total_contract_value"
      ],
      "additionalProperties": false,
      "properties": {
        "total_adjustments": {
          "type": "number"
        },
        "net_total": {
          "type": "number"
        },
        "annualized_total": {
          "type": "number",
          "description": "Recurring net divided by (contract term in months / 12). Excludes one-time charges. Always present when the calculation succeeds."
        },
        "total_contract_value": {
          "type": "number",
          "description": "Sum of the per-period recurring charges over the contract, following any growth schedule, plus one-time charges. Always present when the calculation succeeds. If an unpriced_item warning is present, it covers priced items only and is a lower bound."
        }
      }
    },
    "entitlement_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "credit_type_id",
          "granted",
          "committed_or_used",
          "overage",
          "overage_cost",
          "overage_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "credit_type_id": {
            "$ref": "#/$defs/id"
          },
          "granted": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "committed_or_used": {
            "type": "number"
          },
          "overage": {
            "anyOf": [
              {
                "type": "number",
                "description": "Quantity above the grant. Null means indeterminate, for a credit type with an unknown grant field."
              },
              {
                "type": "null"
              }
            ]
          },
          "overage_cost": {
            "anyOf": [
              {
                "type": "number",
                "description": "Charge for the overage. Null means indeterminate."
              },
              {
                "type": "null"
              }
            ]
          },
          "overage_policy": {
            "type": "string",
            "enum": [
              "pay_as_you_go",
              "hard_cap",
              "throttle",
              "contact_sales",
              "unknown"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "message",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          }
        }
      }
    },
    "computation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "An id: opaque and case-sensitive, lower-case words joined by hyphens. It stays the same across versions of a model while its object exists, and is never reused for a different object."
    },
    "currency_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code."
    }
  }
}
